#!/bin/bash
# startup-watchdog — kill a scheduled agent that starts but never says a word.
#
#   startup-watchdog [-t SECONDS] -l LOGFILE -- command [args...]
#
# Runs the command with its stdout appended to LOGFILE. If LOGFILE is still empty SECONDS after
# launch (default 300), the command's whole process group gets TERM, then KILL 5 s later, and
# the watchdog exits 124. Once the first byte lands, the watchdog steps aside: it never limits
# total run time (keep your own overall timeout for that) and returns the command's own status.
#
# Why: `claude -p` started by launchd/cron has been reported, by several people over several
# releases, to hang at startup with no output at all — for hours, until an overall timeout
# fires. A healthy start is fast: measured on 2026-10-01, `claude -p --output-format stream-json
# --verbose` printed its first line after ~1 s and its `init` event after ~2 s. That only holds
# with a STREAMING output format: in the default text format nothing is printed until the end,
# so a startup watchdog would kill every healthy run. Use stream-json:
#
#   startup-watchdog -t 120 -l "$LOG" -- claude -p "$PROMPT" --output-format stream-json --verbose < /dev/null
#
# (`< /dev/null` matters: with no terminal on stdin, claude -p waits 3 s for piped input first.)
# If the watchdog itself is killed, the agent is not: keep the overall timeout of your scheduler.
#
# Bash 3.2 compatible (stock macOS). No dependencies. Written by an AI agent; read it first.
set -u
T=300; LOG=""
while [ $# -gt 0 ]; do
  case "$1" in
    -t) T="${2:-}"; shift 2 ;;
    -l) LOG="${2:-}"; shift 2 ;;
    --) shift; break ;;
    *) echo "startup-watchdog: unknown option $1" >&2; exit 2 ;;
  esac
done
case "$T" in ''|*[!0-9]*) echo "startup-watchdog: -t needs whole seconds" >&2; exit 2 ;; esac
[ -n "$LOG" ] && [ $# -gt 0 ] || { echo "usage: startup-watchdog [-t SECONDS] -l LOGFILE -- command..." >&2; exit 2; }

: >> "$LOG" || { echo "startup-watchdog: cannot write $LOG" >&2; exit 2; }
start_size=$(wc -c < "$LOG" | tr -d ' ')

set -m                      # the child gets its own process group, so the kill reaches its children
"$@" >> "$LOG" &
pid=$!
set +m

waited=0
while kill -0 "$pid" 2>/dev/null; do
  size=$(wc -c < "$LOG" | tr -d ' ')
  [ "$size" -gt "$start_size" ] && { wait "$pid"; exit $?; }
  if [ "$waited" -ge "$T" ]; then
    echo "startup-watchdog: no output after ${T}s — killing process group $pid" >&2
    kill -TERM -- "-$pid" 2>/dev/null
    i=0; while kill -0 "$pid" 2>/dev/null && [ $i -lt 5 ]; do sleep 1; i=$((i+1)); done
    kill -KILL -- "-$pid" 2>/dev/null
    wait "$pid" 2>/dev/null
    exit 124
  fi
  sleep 1; waited=$((waited+1))
done
wait "$pid"
