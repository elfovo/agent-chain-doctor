# Present tense, on purpose. This line is printed before a single check has run, so the old
# past tense ("nothing was written") asserted a result that had not happened yet — a free
# target on a tool whose whole pitch is not claiming more than it measured.
printf 'agent-chain-doctor %s — read-only: it writes nothing and opens no socket.\n' "$VERSION"
printf 'Verify that yourself: bash tests/run-tests.sh, cases T35 to T39.\n'

if [ -n "$LAUNCHER" ]; then
  if [ ! -f "$LAUNCHER" ]; then
    echo "agent-chain-doctor: '$LAUNCHER' is not a file." >&2
    exit 2
  fi
  if ! is_text_script "$LAUNCHER"; then
    echo "agent-chain-doctor: '$LAUNCHER' does not start with '#!' — this tool reads shell launchers, not binaries." >&2
    exit 2
  fi
  MARKER_SCORE=$(markers_of "$LAUNCHER")
  find_scheduler_for_launcher || note "no scheduler entry matched this launcher — L1 and L12 will say UNKNOWN. Point at it with --plist if you have one."
elif [ -n "$PLIST" ]; then
  # `--plist FILE` on its own is the documented way out when discovery misses the chain, and
  # it used to be dropped on the floor here: discovery ran anyway, found some OTHER chain, and
  # reported on it at exit 0. The user who mistyped the path got a confident diagnosis of a
  # chain they had not named. The plist now decides, or the tool refuses.
  if ! read_plist "$PLIST"; then
    echo "agent-chain-doctor: '$PLIST' could not be read as a LaunchAgent plist." >&2
    exit 2
  fi
  if [ -z "$SCHED_SCRIPT" ] || [ ! -f "$SCHED_SCRIPT" ]; then
    echo "agent-chain-doctor: '$PLIST' names no readable script to diagnose." >&2
    echo "  (its ProgramArguments point at: ${SCHED_SCRIPT:-nothing this tool could resolve})" >&2
    exit 2
  fi
  if ! is_text_script "$SCHED_SCRIPT"; then
    echo "agent-chain-doctor: '$SCHED_SCRIPT' does not start with '#!' — this tool reads shell launchers, not binaries." >&2
    exit 2
  fi
  LAUNCHER="$SCHED_SCRIPT"
  SCHEDULER="launchd"
  MARKER_SCORE=$(markers_of "$LAUNCHER")
  read_sched_status || true
else
  discover_launchd || discover_cron || discover_systemd || true
  if [ -z "$LAUNCHER" ]; then
    cat >&2 <<'NOCHAIN'

No agent chain found.

This tool looked at your own user's LaunchAgents, your crontab and your systemd user timers,
and found no scheduled script that mentions at least two of: an agent CLI, a lock, a wakeup
file, a prompt file, a keep-awake wrapper.

That is not a verdict on your chain — it is this tool failing to find it. Name the launcher
yourself and it will guess nothing:

    agent-chain-doctor /path/to/your/session.sh

NOCHAIN
    exit 2
  fi
fi

load_assignments || true
classify_paths
load_code || true

# A launcher with no log, no lock, no wakeup file and no prompt file is not a chain this tool
# can say anything true about — and a report full of findings about it would be the exact
# wolf-crying this tool exists not to do. Refuse, and say what would make it work.
if [ -z "$P_LOG$P_LOCK$P_WAKEUP$P_PROMPT" ]; then
  cat >&2 <<NOSTATE

$LAUNCHER
looks like a script, but not like an agent chain: it declares no log, no lock, no wakeup
file and no prompt file that this tool could resolve.

Rather than report on files it has not found, it stops here. If this really is your launcher,
its control paths are built in a way this tool cannot follow (computed at runtime, sourced
from another file, or passed in by the scheduler) — and every finding it could print would be
about a chain it has not actually located.

NOSTATE
  exit 2
fi

printf '\nCHAIN\n'
if [ -n "$SCHEDULER" ]; then
  printf '  %-11s %s · %s%s\n' "scheduler" "$SCHEDULER" "${SCHED_DETAIL:-?}" \
    "${SCHED_STATUS:+ (last status $SCHED_STATUS)}"
else
  printf '  %-11s %s\n' "scheduler" "not identified — diagnosing the launcher alone"
fi
# The fallback used to read "?/5" — a THIRD hand-written copy of the marker denominator, and
# one the case that guards the other two does not look at, because it lives nowhere near
# markers_of. It says nothing a bare "?" does not: the numerator is what is unknown here. So it
# is gone rather than guarded — the first question the gate asks about a published count.
printf '  %-11s %s   (matched %s markers)\n' "launcher" "$LAUNCHER" "${MARKER_SCORE:-?}"
printf '  %-11s %s\n' "state dir" "${STATE_DIR:-not deduced}"
[ -n "$P_PROMPT" ] && printf '  %-11s %s\n' "prompt" "$P_PROMPT"
[ -n "$AGENT_BIN" ] && printf '  %-11s %s\n' "agent" "$AGENT_BIN"
[ -n "$DISCOVERY_NOTES" ] && printf '%s' "$DISCOVERY_NOTES"

check_L1_exit_status
