printf '\nFINDINGS\n'
[ -n "$OUT_EXPOSED" ] && printf '%s' "$OUT_EXPOSED"
if [ "$VERBOSE" -eq 1 ]; then
  [ -n "$OUT_GUARDED_F" ] && printf '%s' "$OUT_GUARDED_F"
  [ -n "$OUT_UNKNOWN_F" ] && printf '%s' "$OUT_UNKNOWN_F"
else
  [ -n "$OUT_GUARDED_S" ] && printf '%s' "$OUT_GUARDED_S"
  [ -n "$OUT_UNKNOWN_S" ] && printf '%s' "$OUT_UNKNOWN_S"
fi
printf '\n  %s exposed · %s guarded · %s unknown\n' "$N_EXPOSED" "$N_GUARDED" "$N_UNKNOWN"
[ "$VERBOSE" -eq 0 ] && [ $((N_GUARDED + N_UNKNOWN)) -gt 0 ] \
  && printf '  (--verbose prints the evidence under GUARDED and UNKNOWN too)\n'

